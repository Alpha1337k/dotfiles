[user]
	email = oscar@kruithof.io
	name = Alpha1337k
[column]
        ui = auto
[branch]
        sort = -committerdate
[tag]
        sort = version:refname
[init]
        defaultBranch = main
[diff]
        algorithm = histogram
        colorMoved = plain
        mnemonicPrefix = true
        renames = true
[push]
        default = simple
        autoSetupRemote = true
        followTags = true
[fetch]
        prune = true
        pruneTags = true
        all = true

# why the hell not?

[help]
        autocorrect = prompt
[commit]
        verbose = true
[rerere]
        enabled = true
        autoupdate = true
[core]
        excludesfile = ~/.gitignore
	pager = delta
[rebase]
        autoSquash = true
        autoStash = true
        updateRefs = true
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	hyperlinks = true
[merge]
	conflictStyle = zdiff3
