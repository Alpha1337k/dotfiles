#!/usr/bin/env python3
"""
OpenRouter CLI - A command line interface for interacting with OpenRouter API
"""

import argparse
import json
import os
import sys
import requests
from datetime import datetime
from typing import Dict, Any, Optional

API_URL = "https://openrouter.ai/api/v1"

def load_config() -> Dict[str, str]:
    """Load configuration from file or environment variables."""
    config = {}
    
    # Check for config file
    config_path = os.path.expanduser("~/.openrouter_config")
    if os.path.exists(config_path):
        try:
            with open(config_path, "r") as f:
                config = json.load(f)
        except json.JSONDecodeError:
            print("Error: Invalid config file format")
            sys.exit(1)
    
    # Check for environment variables (overrides config file)
    if "OPENROUTER_API_KEY" in os.environ:
        config["api_key"] = os.environ["OPENROUTER_API_KEY"]
    
    return config

def save_config(config: Dict[str, str]) -> None:
    """Save configuration to file."""
    config_path = os.path.expanduser("~/.openrouter_config")
    with open(config_path, "w") as f:
        json.dump(config, f, indent=2)
    os.chmod(config_path, 0o600)  # Make config file private
    print(f"Configuration saved to {config_path}")



def make_api_request(endpoint: str, data: Dict[str, Any], api_key: str) -> Dict[str, Any]:
    """Make a request to the OpenRouter API."""
    headers = {
        "Content-Type": "application/json",
        "Authorization": f"Bearer {api_key}",
        "HTTP-Referer": "https://openrouter-cli",  # Identifying application
    }
    
    response = requests.post(f"{API_URL}/{endpoint}", headers=headers, json=data)
    
    if response.status_code != 200:
        print(f"Error: API request failed with status code {response.status_code}")
        print(response.text)
        sys.exit(1)
    
    return response.json()

def chat_completion(args: argparse.Namespace, config: Dict[str, str]) -> None:
    """Send a chat completion request."""
    if not args.message and not args.file:
        print("Error: Either --message or --file must be provided")
        sys.exit(1)
    
    # Prepare messages
    messages = []
    if args.file:
        try:
            with open(args.file, "r") as f:
                messages = json.load(f)
        except json.JSONDecodeError:
            print("Error: Invalid JSON in messages file")
            sys.exit(1)
    else:
        messages = [{"role": "user", "content": args.message}]
    
    # Prepare request data
    data = {
        "messages": messages,
        "model": args.model,
        "stream": args.stream,
    }
    
    # Add optional parameters
    if args.temperature is not None:
        data["temperature"] = args.temperature
    if args.max_tokens is not None:
        data["max_tokens"] = args.max_tokens
    
    # Make API request
    if args.stream:
        print("Streaming not implemented yet. Please use --no-stream")
        sys.exit(1)
    else:
        response = make_api_request("chat/completions", data, config["api_key"])
        
        if args.raw:
            print(json.dumps(response, indent=2))
        else:
            print(response["choices"][0]["message"]["content"])

def list_models(args: argparse.Namespace, config: Dict[str, str]) -> None:
    """List available models."""
    response = requests.get(f"{API_URL}/models", headers={"Authorization": f"Bearer {config['api_key']}"})
    
    if response.status_code != 200:
        print(f"Error: Failed to retrieve models with status code {response.status_code}")
        print(response.text)
        sys.exit(1)
    
    models = response.json()["data"]
    
    if args.raw:
        print(json.dumps(models, indent=2))
    else:
        print("Available models:")
        for model in models:
            print(f"- {model['id']} {datetime.fromtimestamp(model['created']).strftime('%d-%m-%Y')}")

def configure(args: argparse.Namespace) -> None:
    """Configure the CLI."""
    config = load_config()
    
    if args.api_key:
        config["api_key"] = args.api_key
    else:
        api_key = input("Enter your OpenRouter API key: ")
        if api_key.strip():
            config["api_key"] = api_key
    
    save_config(config)
    print("Configuration updated")

def main() -> None:
    """Main entry point for the CLI."""
    parser = argparse.ArgumentParser(description="Command-line interface for OpenRouter API")
    subparsers = parser.add_subparsers(dest="command", help="Command to execute")
    
    # Chat completion command
    chat_parser = subparsers.add_parser("chat", help="Send a chat completion request")
    chat_parser.add_argument("-m", "--message", help="Message to send")
    chat_parser.add_argument("-f", "--file", help="Path to a JSON file containing messages")
    chat_parser.add_argument("--model", default="openai/gpt-3.5-turbo", help="Model to use")
    chat_parser.add_argument("--temperature", type=float, help="Temperature parameter")
    chat_parser.add_argument("--max-tokens", type=int, help="Maximum tokens to generate")
    chat_parser.add_argument("--raw", action="store_true", help="Print raw JSON response")
    chat_parser.add_argument("--stream", action="store_true", help="Stream the response")
    chat_parser.add_argument("--no-stream", dest="stream", action="store_false", help="Do not stream the response")
    chat_parser.set_defaults(stream=False)
    
    # List models command
    models_parser = subparsers.add_parser("models", help="List available models")
    models_parser.add_argument("--raw", action="store_true", help="Print raw JSON response")
    
    # Configure command
    config_parser = subparsers.add_parser("config", help="Configure the CLI")
    config_parser.add_argument("--api-key", help="Set the API key")
    
    args = parser.parse_args()
    
    if args.command == "config":
        configure(args)
    elif args.command in ["chat", "models"]:
        config = load_config()
        if "api_key" not in config:
            print("Error: API key not configured. Run 'openrouter config' first.")
            sys.exit(1)
        
        if args.command == "chat":
            chat_completion(args, config)
        elif args.command == "models":
            list_models(args, config)
    else:
        parser.print_help()

if __name__ == "__main__":
    main()