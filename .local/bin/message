#!/usr/bin/env bash
set -euo pipefail

source ~/.env

MAX_MESSAGE_LEN=1024

MESSAGE=${@:-$(cat -)}

if [ -z ${TELEGRAM_BOT_API_KEY+x} ] 
then
	echo "message: error: no TELEGRAM_BOT_API_KEY provided"
	exit 1
fi

if [ -z ${TELEGRAM_CHAT_ID+x} ] 
then
	echo "message: error: no TELEGRAM_CHAT_ID provided"
	exit 1
fi

if [ ${#MESSAGE} -ge $MAX_MESSAGE_LEN ]
then
	>&2 echo "message: warn: message will be cut to 1024 characters"

	MESSAGE="${MESSAGE:0:1022}.."
fi

# curl -X POST https://api.telegram.org/bot$TELEGRAM_BOT_API_KEY/getUpdates

## UPLOAD

set +e

MESSAGE_UPLOAD=$(curl -s --show-error --fail --output /dev/null -X POST https://api.telegram.org/bot$TELEGRAM_BOT_API_KEY/sendMessage -d chat_id=$TELEGRAM_CHAT_ID -d text="$MESSAGE" 2>&1)
MESSAGE_UPLOAD_STATUS=$?

set -e

## -- UPLOAD

if [ $MESSAGE_UPLOAD_STATUS -ne 0 ]
then
	echo "message: error: message upload failed: $MESSAGE_UPLOAD"
	exit 1
fi


