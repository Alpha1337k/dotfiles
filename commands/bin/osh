#!/usr/bin/env bash
set -euo pipefail

DOTFILES_DIR="$HOME/dotfiles"

show_help() {
    cat << EOF
osh - Oh my shell dotfiles manager

Usage: osh <command>

Commands:
    add           Add a package to dotfiles
    update        Update dotfiles (git pull, packages, stow)
    check-updates Check if updates are available (silent)
    help          Show this help message

Examples:
    osh add brew htop          # Add htop via brew
    osh update                 # Pull latest changes and update system
    osh help                   # Show help
EOF
}

update_dotfiles() {
    echo "🔄 Updating dotfiles..."
    
    cd "$DOTFILES_DIR"
    
    echo "📥 Pulling latest changes..."
    git pull
    
    echo "📦 Installing/updating packages..."
    ./packages.sh
    
    echo "🔗 Applying stow configurations..."
    ./stow.sh
    
    echo "✅ Dotfiles updated successfully!"
}

check_updates() {
    cd "$DOTFILES_DIR"
    
    # Fetch latest changes without merging
    git fetch origin main >/dev/null 2>&1
    
    # Check if local is behind remote
    LOCAL=$(git rev-parse HEAD)
    REMOTE=$(git rev-parse origin/main)
    
    if [ "$LOCAL" != "$REMOTE" ]; then
        exit 0  # Updates available
    else
        exit 1  # No updates
    fi
}

select_repo_type() {
    local prompt="\
Select package repository
1) brew
2) node
3) python/uv

Enter choice (1-3): "

    read -p "$prompt" choice

    case "$choice" in
        1) echo "brew" ;;
        2) echo "node" ;;
        3) echo "uv" ;;
        *)
            echo "❌ Invalid choice"
            exit 1
            ;;
    esac
}

add_package() {
    local repo_type="$1"
    local package_name="$2"
    
    cd "$DOTFILES_DIR"
    
    case "$repo_type" in
        brew)
            echo "📦 Adding brew package: $package_name"
            brew bundle add "$package_name"
			brew bundle
            ;;
        # node)
        #     echo "📦 Adding node package: $package_name"
        #     npm install -g "$package_name"
        #     ;;
        python|uv)
            echo "📦 Adding python tool: $package_name"
            uv tool install "$package_name"
            ;;
        *)
            echo "❌ Error: Unknown repository type '$repo_type'"
            echo "Supported types: brew, node, python, uv"
            exit 1
            ;;
    esac
    
    echo "✅ Package $package_name added successfully!"
}

add() {
	if [ -z "${2:-}" ]; then
		echo "❌ Error: Package name required"
		echo "Usage: osh add [brew|node|python|uv] <package>"
		echo "   or: osh add <package> (interactive mode)"
		exit 1
	fi
	
	if [ -z "${3:-}" ]; then
		# Interactive mode - package name provided but no repo type
		repo_type=$(select_repo_type)
		add_package "$repo_type" "$2"
	else
		# Both repo type and package name provided
		add_package "$2" "$3"
	fi
}

case "${1:-}" in
    add)
		add $@
        ;;
    update)
        update_dotfiles
        ;;
    check-updates)
        check_updates
        ;;
    help|--help|-h)
        show_help
        ;;
    "")
        show_help
        exit 1
        ;;
    *)
        echo "Error: Unknown command '$1'"
        echo ""
        show_help
        exit 1
        ;;
esac