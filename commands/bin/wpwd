#!/usr/bin/python3
import os

current_dir = os.getcwd()

if current_dir.startswith("/mnt/") and not current_dir.startswith("/mnt/wsl"):
    parts = current_dir.split("/")[2:]

    start = parts[0].upper() + ":"
    rest = '\\'.join(parts[1:])

    print(f"{start}\\{rest}")
else:
    start = "\\\\wsl.localhost\\"
    os_name = f"{os.getenv('WSL_DISTRO_NAME')}"
    current_dir = current_dir.replace('/', '\\')

    print(f"{start}{os_name}{current_dir}")
